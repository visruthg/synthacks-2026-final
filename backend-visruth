@app.after_request  # runs after every response
def _cors_headers(response: Any) -> Any:
    """
    Allow friends' frontends/code on other origins to call this JSON API
    (browser CORS).  API routes can be reached from any origin.
    """  # enables cross-origin access for friends' browser code
    if request.path.startswith("/api"):  # only for API routes

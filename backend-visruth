def _post_json(url: str, payload: Dict[str, Any]) -> None:
    """Minimal JSON POST without adding a 'requests' dependency."""  # tiny HTTP POST helper
    import json  # json module for serialization
    import urllib.request  # built-in HTTP client

    req = urllib.request.Request(  # build an HTTP request object
        url,  # the target URL
        data=json.dumps(payload).encode("utf-8"),  # serialize payload to JSON bytes
        headers={"Content-Type": "application/json"},  # tell the server we send JSON
        method="POST",  # use the POST verb
    )
    with urllib.request.urlopen(req, timeout=5):  # noqa: S310 - local network integration  # send the request (max 5s)
        pass  # we don't need the response body



class Store:
    """In-memory database with a lock (safe for the background sweeper thread)."""  # thread-safe data storage

    def __init__(self) -> None:  # constructor for the store
        self._lock: threading.Lock = threading.Lock()  # lock so threads don't corrupt data
        self.patients: Dict[str, Patient] = {}  # all patients keyed by patient id
        self.episodes: Dict[str, Episode] = {}  # all episodes keyed by episode id

    def add_patient(self, patient: Patient) -> None:  # save a new patient
        with self._lock:  # acquire the lock before touching data
            self.patients[patient.id] = patient  # store the patient under their id

    def add_episode(self, episode: Episode) -> None:  # save a new episode
        with self._lock:  # acquire the lock before touching data
            self.episodes[episode.id] = episode  # store the episode under its id
            self.patients[episode.patient_id].episodes.append(episode.id)  # link the episode to its patient's history

    def get_patient(self, pid: str) -> Optional[Patient]:  # fetch one patient by id
        with self._lock:  # acquire the lock before reading
            return self.patients.get(pid)  # return the patient (None if missing)

    def get_episode(self, eid: str) -> Optional[Episode]:  # fetch one episode by id
        with self._lock:  # acquire the lock before reading
            return self.episodes.get(eid)  # return the episode (None if missing)

    def patient_history(self, pid: str) -> List[Episode]:  # get all episodes of a patient
        with self._lock:  # acquire the lock before reading
            patient = self.patients.get(pid)  # look up the patient
            if patient is None:  # if the patient doesn't exist
                return []  # return an empty history
            return [self.episodes[e] for e in patient.episodes if e in self.episodes]  # map episode ids to episode objects


STORE: Store = Store()  # the single global database instance used everywhere


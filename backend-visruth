    contacts: List[Contact] = []  # start with an empty contact list
    for i in (1, 2):  # support up to two emergency contacts
        cname = request.form.get(f"contact{i}_name", "").strip()  # contact name field
        cphone = request.form.get(f"contact{i}_phone", "").strip()  # contact phone field
        crelation = request.form.get(f"contact{i}_relation", "").strip()  # contact relation field
        if cname or cphone:  # only add if at least a name or phone was given

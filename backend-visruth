def _now() -> str:
    """Return the current local time as an ISO-ish string."""  # timestamp helper
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")  # format now as "YYYY-MM-DD HH:MM:SS"


def _timestamp() -> float:
    """Return current unix time in seconds (for deadlines)."""  # unix-time helper
    return time.time()  # seconds since epoch


def _clean_symptoms(raw: str) -> List[str]:
    """Split a free-text symptom string into a clean list of keywords."""  # input normalisation
    parts = [p.strip().lower() for p in raw.replace("\n", ",").split(",")]  # split on commas/newlines, trim + lowercase each
    return [p for p in parts if p]  # drop any empty strings


def assess_severity(symptoms: List[str]) -> str:
    """Classify a list of symptoms into low/medium/high/critical."""  # severity classifier
    text = " ".join(symptoms)  # join all symptoms into one searchable string
    for level in ("critical", "high", "medium"):  # check the most dangerous levels first
        if any(kw in text for kw in SEVERITY_RULES[level]):  # if any keyword of this level is in the text
            return level  # return that severity immediately
    return "low"  # nothing matched -> classify as low


def find_remedy(symptoms: List[str]) -> Optional[Remedy]:
    """Return the first matching home remedy for the symptoms, or None."""  # remedy lookup
    text = " ".join(symptoms)  # join all symptoms into one searchable string
    for rule in REMEDY_RULES:  # loop over every known remedy rule
        if any(kw in text for kw in rule.keywords):  # if any keyword of the rule matches
            return rule.remedy  # return that rule's remedy
    return None  # no rule matched -> no remedy


def diagnosis_for(symptoms: List[str]) -> str:
    """Return a human-readable diagnosis for the symptoms."""  # diagnosis lookup
    text = " ".join(symptoms)  # join all symptoms into one searchable string
    for rule in REMEDY_RULES:  # loop over every known remedy rule
        if any(kw in text for kw in rule.keywords):  # if any keyword of the rule matches
            return rule.diagnosis  # return that rule's diagnosis
    return "General symptoms - advice given below"  # fallback diagnosis when nothing matches


def estimate_cost(severity: str, symptom_count: int) -> float:
    """Estimate treatment cost from severity + number of symptoms."""  # cost estimator
    base = COST_BY_SEVERITY.get(severity, 150.0)  # look up the base cost for this severity
    return round(base * (1 + 0.03 * symptom_count), 2)  # scale slightly with symptom count and round to 2 decimals


def reaction_delay_seconds(remedy: Optional[Remedy]) -> float:
    """Delay before auto-ambulance, based on the medicine reaction time."""  # timer length calculator
    minutes = remedy.reaction_minutes if remedy else 30  # use the remedy's reaction time (default 30 if none)
    if TIMER_MODE == "fast":  # in demo mode
        return float(minutes)          # seconds for demo/testing  # count the "minutes" as seconds
    return float(minutes) * 60.0       # real minutes in production  # convert minutes to seconds for the countdown



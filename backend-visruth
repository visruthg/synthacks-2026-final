@app.route("/api/episodes/<eid>/actions", methods=["POST"])  # remote action trigger for friends
def api_episode_action(eid: str) -> Any:
    """Friends trigger actions: hospital | contacts | ambulance | resolve | insurance."""  # action API handler
    episode = STORE.get_episode(eid)  # look up the episode
    if episode is None:  # not found
        return jsonify({"error": "episode not found"}), 404  # return 404
    data = request.get_json(silent=True) or {}  # parse the JSON body
    if isinstance(data, str):  # tolerate a bare string body
        action = data.strip().lower()  # treat the whole body as the action
        data = {}  # reset data to an empty dict
    else:  # normal dict body
        action = str(data.get("action", "")).strip().lower()  # read the action field

    patient = STORE.get_patient(episode.patient_id)  # load the episode's patient
    if action == "ambulance":  # dispatch the ambulance
        episode.status = "ambulance_dispatched"  # mark dispatched
        episode.deadline_ts = None  # clear the timer
        episode.actions.append({"ts": _now(), "type": "ambulance",  # log it
                                "message": "Ambulance dispatched via API."})  # record the event
        notify_external("ambulance", _base_payload(patient, episode) if patient else {})  # notify friends' ambulance code
    elif action == "hospital":  # notify the hospital
        episode.actions.append({"ts": _now(), "type": "hospital",  # log it
                                "message": "Hospital notified via API."})  # record the event
        notify_external("hospital", _base_payload(patient, episode) if patient else {})  # notify friends' hospital code
    elif action == "contacts":  # call the emergency contacts
        episode.actions.append({"ts": _now(), "type": "contacts",  # log it
                                "message": "Emergency contacts called via API."})  # record the event
        notify_external("contacts", _base_payload(patient, episode) if patient else {})  # notify friends' SMS code
    elif action == "resolve":  # mark the episode resolved
        episode.status = "resolved"  # set resolved
        episode.deadline_ts = None  # clear the timer
        episode.actions.append({"ts": _now(), "type": "resolve",  # log it
                                "message": "Resolved via API."})  # record the event
    elif action == "insurance":  # handle insurance choice
        choice = data.get("choice", "no") if isinstance(data, dict) else "no"  # read the choice
        episode.insurance_status = "applied" if choice == "yes" else "declined"  # update insurance state
        episode.actions.append({"ts": _now(), "type": "insurance",  # log it
                                "message": "Insurance handled via API."})  # record the event
    else:  # unknown action
        return jsonify({"error": f"unknown action '{action}'"}), 400  # return 400
    return jsonify(episode_to_json(episode))  # return the updated episode



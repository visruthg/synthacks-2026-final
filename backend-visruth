    contacts = [Contact(str(c.get("name", "")), str(c.get("phone", "")),  # build Contact objects from JSON
                        str(c.get("relation", ""))) for c in data.get("contacts", [])]  # one per contact entry
    patient = Patient(id=uuid.uuid4().hex[:10], name=name,  # build a new Patient with a random id
                      age=int(data.get("age", 0) or 0),  # age from JSON (default 0)
                      weight_kg=float(data.get("weight_kg", 0) or 0),  # weight from JSON (default 0)
                      blood_group=str(data.get("blood_group", "Unknown")),  # blood group from JSON
                      allergies=[str(a) for a in data.get("allergies", [])],  # allergies list from JSON
                      contacts=contacts, created_at=_now())  # contacts + creation time
    STORE.add_patient(patient)  # save the patient
    return jsonify(patient_to_json(patient)), 201  # return the created patient with HTTP 201


@app.route("/api/severity", methods=["POST"])  # the MAIN assessment endpoint
def api_severity() -> Any:
    """
    The MAIN endpoint friends call. Send symptoms, get severity + advice.
    Body: {"symptoms": ["chest pain"], "patient_id": "optional"}
    """  # severity assessment API
    data = request.get_json(silent=True) or {}  # parse the JSON body
    symptoms = [str(s).lower() for s in data.get("symptoms", [])]  # read + lowercase the symptoms list
    if not symptoms:  # symptoms are required
        return jsonify({"error": "symptoms are required"}), 400  # return a 400 error

    severity = assess_severity(symptoms)  # classify severity
    remedy = find_remedy(symptoms)  # find the remedy
    diagnosis = diagnosis_for(symptoms)  # get the diagnosis
    cost = estimate_cost(severity, len(symptoms))  # estimate cost

    payload = {  # build the response
        "severity": severity,  # the severity level (friends' key field)
        "diagnosis": diagnosis,  # diagnosis text
        "estimated_cost": cost,  # estimated cost
        "insurance_needed": cost > INSURANCE_COVER_LIMIT,  # whether insurance is needed
        "recommendation": ("IMMEDIATE HOSPITAL" if severity in ("high", "critical")  # advice for serious cases
                           else "home remedy"),  # advice for mild cases
        "remedy": {"medicine": remedy.medicine, "dosage": remedy.dosage,  # remedy details
                   "reaction_minutes": remedy.reaction_minutes,  # reaction time (for the timer)
                   "note": remedy.note} if remedy else None,  # advice note, or None if no remedy
        "action": ("hospital" if severity in ("high", "critical") else "remedy"),  # recommended next action
    }
    if data.get("patient_id"):  # if a patient id was supplied
        # attach the patient profile (or None if the id is unknown)
        payload["patient"] = patient_to_json(STORE.get_patient(data["patient_id"])) \
            if STORE.get_patient(data["patient_id"]) else None
    return jsonify(payload)  # return the assessment



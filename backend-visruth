        severity=severity,  # classified severity
        diagnosis=diagnosis,  # diagnosis text
        remedy={"medicine": remedy.medicine, "dosage": remedy.dosage,  # remedy dict (medicine name + dosage
                "reaction_minutes": remedy.reaction_minutes, "note": remedy.note,  # reaction time + advice
                "price": remedy.price} if remedy else None,  # price, or None if no remedy
        est_cost=cost,  # estimated cost
        status="remedy_active" if severity in ("low", "medium") else "hospital_notified",  # low/medium start with remedy active; otherwise hospital alert
        created_at=_now(),  # timestamp the episode
        deadline_ts=_timestamp() + reaction_delay_seconds(remedy) if remedy  # timer = now + reaction delay (only for low/medium)
        and severity in ("low", "medium") else None,  # no timer for high/critical
    )

    episode.actions.append({"ts": _now(), "type": "assess",  # log the initial assessment step
                            "message": f"Symptoms: {', '.join(symptoms)} | Severity: {severity.upper()}"})  # record what was reported and classified
    if severity in ("low", "medium") and remedy:  # if we can give a home remedy
        episode.actions.append({"ts": _now(), "type": "remedy",  # log the remedy step
                                "message": f"Prescribed {remedy.medicine} ({remedy.dosage}). Reaction window: "  # record the prescription
                                           f"~{remedy.reaction_minutes} min."})  # note the reaction window length
    if severity in ("high", "critical"):  # if it is serious
        episode.actions.append({"ts": _now(), "type": "hospital",  # log the hospital alert
                                "message": f"CRITICAL ALERT sent to {DEFAULT_HOSPITAL}. Ambulance: {AMBULANCE_PHONE}."})  # record hospital + ambulance line
        episode.actions.append({"ts": _now(), "type": "contacts",  # log the contacts alert
                                "message": "Emergency contacts notified (simulated)."})  # record contact notification
        notify_external("hospital", _base_payload(patient, episode))  # notify friends' hospital code
        notify_external("contacts", _base_payload(patient, episode))  # notify friends' contact/SMS code
    if severity == "critical":  # for the worst cases
        episode.actions.append({"ts": _now(), "type": "ambulance",  # log the ambulance dispatch
                                "message": f"Ambulance dispatched via {AMBULANCE_PHONE}."})  # record the dispatch
        episode.status = "ambulance_dispatched"  # mark the episode as ambulance dispatched
        notify_external("ambulance", _base_payload(patient, episode))  # notify friends' ambulance code
    if cost > INSURANCE_COVER_LIMIT and severity in ("high", "critical"):  # if the bill exceeds the insurance limit
        episode.insurance_status = "offered"  # mark insurance as offered
        episode.actions.append({"ts": _now(), "type": "insurance",  # log the insurance offer
                                "message": f"Estimated cost {cost:.2f} exceeds cover {INSURANCE_COVER_LIMIT:.2f} - insurance offered."})  # record cost vs cover

    STORE.add_episode(episode)  # save the new episode
    return redirect(url_for("episode_page", eid=episode.id))  # show the result page


def _base_payload(patient: Patient, episode: Episode) -> Dict[str, Any]:
    """Shared payload sent to friends' integration endpoints."""  # common webhook payload builder
    return {  # build the payload
        "event": "medical_assistance",  # what happened
        "patient": patient_to_json(patient),  # full patient info
        "episode": episode_to_json(episode),  # full episode info
        "severity": episode.severity,  # severity (the key field for friends)
        "hospital": DEFAULT_HOSPITAL,  # which hospital to alert
        "ambulance_phone": AMBULANCE_PHONE,  # the ambulance number
    }



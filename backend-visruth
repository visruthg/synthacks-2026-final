def _owned_episode(eid: str) -> Optional[Episode]:
    """Return the episode if it belongs to the logged-in patient."""  # ownership guard
    patient = STORE.get_patient(session.get("patient_id", ""))  # load the logged-in patient
    episode = STORE.get_episode(eid)  # load the requested episode
    if patient is None or episode is None or episode.patient_id != patient.id:  # must belong to this patient
        return None  # not allowed -> return None
    return episode  # allowed -> return the episode


def _auto_ambulance_sweep(episode: Episode) -> None:
    """If the remedy deadline passed, dispatch the ambulance automatically."""  # timer expiry check
    if (episode.status == "remedy_active" and episode.deadline_ts  # only active remedy episodes with a deadline
            and _timestamp() >= episode.deadline_ts):  # and the deadline has passed
        patient = STORE.get_patient(episode.patient_id)  # load the patient
        episode.status = "ambulance_dispatched"  # mark as dispatched
        episode.deadline_ts = None  # clear the timer
        episode.actions.append({"ts": _now(), "type": "ambulance",  # log the auto-dispatch
                                "message": "Remedy did NOT work within the reaction window - "  # record why
                                           f"AMBULANCE auto-dispatched ({AMBULANCE_PHONE})."})  # record the ambulance line
        if patient:  # only notify if we have the patient
            notify_external("ambulance", _base_payload(patient, episode))  # notify friends' ambulance code


def background_sweeper() -> None:
    """Background thread: auto-ambulance even when nobody visits the page."""  # the watchdog thread
    while True:  # run forever
        time.sleep(SWEEP_INTERVAL)  # wait between checks
        for eid in list(STORE.episodes):  # iterate over a snapshot of all episodes
            episode = STORE.get_episode(eid)  # fetch each episode
            if episode:  # if it exists
                _auto_ambulance_sweep(episode)  # check its timer and auto-dispatch if expired


